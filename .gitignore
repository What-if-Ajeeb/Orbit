# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# logs and local runtime state
*.log
*.pid
lockllm/logs/

# build / release outputs
artifacts/
# artifact feature source is code, not a build output
!/src/lib/artifacts/
symbols/
coverage/
*.apk
*.aab
*.ipa

# Android signing (CI-only, never commit)
android-signing/

# editors
.idea/
.vscode/

# python tooling
__pycache__/
*.pyc

# generated native folders
/ios
/android

# Rust build output and cargo-ndk generated native libraries
/sandbox-core/target/
/modules/orbit-mobile-sandbox/android/src/main/jniLibs/

# Android signing
*.keystore
*.jks
keystore.properties
android/app/release.keystore
