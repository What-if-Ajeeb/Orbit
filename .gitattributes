# Normalize line endings so Windows, macOS, Linux, and CI produce identical diffs.
* text=auto eol=lf

# Scripts and config must keep LF.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.pdf binary
*.apk binary
*.aab binary
*.ipa binary
*.jar binary
*.keystore binary
*.jks binary
*.so binary

# Lockfiles: generated, still reviewed, but not diff-noisy.
package-lock.json -diff linguist-generated=true
